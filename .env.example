# Shared Supabase project. Never expose the service-role key to the browser.
SUPABASE_URL=https://your-new-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-new-service-role-key
VITE_SUPABASE_URL=https://your-new-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-new-anon-key

# Vernika admin access. Use unique, high-entropy values.
ADMIN_USERNAME=replace-with-admin-username
ADMIN_PASSWORD=replace-with-admin-password
ADMIN_OTP=replace-with-admin-otp
SESSION_SECRET=replace-with-at-least-32-random-characters
CREDENTIAL_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# Blogger publishing and scheduled publishing
GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_REFRESH_TOKEN=your-google-refresh-token
BLOGGER_BLOG_ID=your-blog-id
PUBLISH_SECRET=replace-with-publish-secret
CRON_SECRET=replace-with-cron-secret
APP_URL=https://your-vercel-deployment.vercel.app

# Optional server-side AI providers
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
POLLINATIONS_API_KEY=
POLLINATIONS_APP_KEY=
INDEXNOW_KEY=

# Firebase Web configuration (only if Google/Firebase sign-in is enabled)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Local development
PORT=3000
